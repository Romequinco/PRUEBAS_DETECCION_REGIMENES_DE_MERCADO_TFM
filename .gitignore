# ==========================================================================================
# .gitignore del TFM. Dos bloques: (1) Python y herramientas, (2) datos y resultados del
# proyecto. Regla general de results/: se versiona lo pequeño (CSV, JSON, MD) y se ignoran los
# binarios regenerables; las excepciones (!) son ficheros que el código necesita en un clon limpio.
# ==========================================================================================

# --- 1. Python, entornos y herramientas ---------------------------------------------------
__pycache__/
*.py[codz]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-log.txt
.pytest_cache/
.hypothesis/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
*.lcov
.ipynb_checkpoints
*.log
*.log.*

# Entornos virtuales (el de la Fase 2 suele llamarse .venv-ingesta)
.venv
.venv-*/
venv/
env/
ENV/

# Secretos y credenciales (se versiona solo la plantilla .env.example)
.env
.env.*
!.env.example
.envrc
.dev.vars
.dev.vars.*
*.pem
*.key
.pypirc
.streamlit/secrets.toml

# Bases de datos locales y basura del sistema
*.sqlite
*.sqlite3
*.db
*.rdb
.DS_Store
celerybeat-schedule*
tempCodeRunnerFile.py

# --- 2. Datos y resultados del proyecto ---------------------------------------------------
# Datos crudos y procesados (se regeneran con python -m regimenes.datos y notebooks/03);
# se versionan solo los metadatos de procedencia.
data/raw/*
data/processed/*
!data/processed/.gitkeep
!data/raw/provenance.json
!data/raw/coverage_report.csv

# Binarios regenerables de results/
results/*.png
results/*.parquet
results/**/*.png
results/detectores/**/*.parquet
results/pseudolive/**/*.parquet

# Paneles OOS del benchmark: se regeneran con python -m regimenes.benchmark. EXCEPCIÓN: los dos
# que lee get_regimen (configs/regimen.yaml) se versionan para que la tool funcione en un clon.
results/benchmark/panels/*.parquet
!results/benchmark/panels/A_D06.parquet
!results/benchmark/panels/B_D05.parquet

# Ablaciones: un CSV por trabajo (marca de «hecho» de benchmark/ablaciones.py). Se versiona el
# consolidado trabajos.csv que escribe ablaciones_lectura.escribir_tablas().
results/detectores/ablaciones/?_D??_*.csv

# Sintéticos (notebooks fase1/17–20): trayectorias generadas, modelos, filas por trabajo y estado de ejecución
# se regeneran; se versionan los CSV/JSON/MD pequeños de results/sinteticos
data/sinteticos/*
!data/sinteticos/.gitkeep
results/sinteticos/**/*.parquet
results/sinteticos/**/*.pkl
results/sinteticos/**/*.pickle
results/sinteticos/**/*.joblib
results/sinteticos/**/*.pt
results/sinteticos/**/*.pth
results/sinteticos/**/*.npy
results/sinteticos/**/*.npz
results/sinteticos/laboratorio/filas/
results/sinteticos/aumento/filas/
results/sinteticos/aumento/.ejecutando
results/sinteticos/aumento/estado_*.txt

# Documentación interna del TFM: solo local, nunca se versiona
docs/tfm/internos/
